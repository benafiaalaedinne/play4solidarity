    <script>
        // FONCTIONS DE NAVIGATION
        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            const targetPage = document.getElementById(pageId);
            if (targetPage) {
                targetPage.classList.add('active');
            }
        }

        function showTournamentDetail(tournament) {
            showPage(tournament + '-detail');
        }

        function showPlaceholder(img) {
            img.style.display = 'none';
            const placeholder = img.nextElementSibling;
            if (placeholder && placeholder.classList.contains('img-placeholder')) {
                placeholder.style.display = 'flex';
            }
        }

        // GESTION DES FORMULAIRES POUR TOUS LES JEUX
        document.addEventListener('DOMContentLoaded', function() {
            // Fonction générique pour gérer les formulaires
            function setupForm(formId, confirmationId) {
                const form = document.getElementById(formId);
                const confirmation = document.getElementById(confirmationId);
                if (form && confirmation) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        // Afficher le message de confirmation
                        confirmation.style.display = 'block';
                        // Cacher le formulaire
                        form.style.display = 'none';
                        // Optionnel: Rediriger après 3 secondes
                        setTimeout(() => {
                            showPage('home');
                        }, 3000);
                    });
                }
            }

            // Configurer tous les formulaires
            setupForm('fortnite-form', 'fortnite-confirmation');
            setupForm('lol-form', 'lol-confirmation');
            setupForm('csgo-form', 'csgo-confirmation');
            setupForm('apex-form', 'apex-confirmation');
            setupForm('fifa-form', 'fifa-confirmation');
            setupForm('dota-form', 'dota-confirmation');

            // Gestion des erreurs d'images
            const images = document.querySelectorAll('.card img');
            images.forEach(img => {
                img.onerror = function() {
                    showPlaceholder(this);
                };
            });
        });
    </script>
