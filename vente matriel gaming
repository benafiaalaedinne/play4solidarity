        }

        .thumbnail.active {
            border-color: var(--accent);
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-detail-info {
            flex: 1;
        }

        .product-detail-name {
            font-size: 32px;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 15px;
            letter-spacing: -0.5px;
        }

        .product-detail-rating {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .product-detail-rating .stars {
            color: #ffc107;
            font-size: 20px;
        }

        .product-detail-price {
            font-size: 42px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--accent) 100%);
