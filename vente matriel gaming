        }

        .product-detail-stock.in-stock {
            background: #e8f5e9;
            color: #4caf50;
        }

        .product-detail-stock.low-stock {
            background: #fff3e0;
            color: #ff9800;
        }

        .product-detail-stock.out-of-stock {
            background: #ffebee;
            color: #f44336;
        }

        .product-detail-category {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .product-detail-description {
            color: var(--text-secondary);
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 25px;
        }

        .product-specs {
            background: var(--bg-secondary);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 25px;
        }

        .product-specs h4 {
            color: var(--text-primary);
            font-size: 18px;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .spec-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .spec-item:last-child {
            border-bottom: none;
        }

        .spec-label {
            color: var(--text-secondary);
            font-weight: 600;
        }

        .spec-value {
            color: var(--text-primary);
        }

        .product-features {
            margin-bottom: 25px;
        }

        .product-features h4 {
            color: var(--text-primary);
            font-size: 18px;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 12px;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .feature-item::before {
            content: "✓";
            color: #4caf50;
            font-weight: bold;
            font-size: 18px;
        }

        .product-video {
            margin-bottom: 25px;
            border-radius: 15px;
            overflow: hidden;
        }

        .product-video iframe {
            width: 100%;
            height: 400px;
            border: none;
        }

        .product-detail-actions {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 15px;
            background: var(--bg-secondary);
            padding: 10px 20px;
            border-radius: 12px;
        }

        .quantity-selector button {
            background: var(--primary-dark);
            color: white;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 20px;
            font-weight: bold;
            transition: all 0.3s;
        }

        .quantity-selector button:hover {
            background: var(--primary-light);
        }

        .quantity-selector span {
            font-size: 20px;
            font-weight: 700;
            min-width: 40px;
            text-align: center;
            color: var(--text-primary);
        }

        .product-detail-add-btn {
            flex: 1;
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
            color: white;
            border: none;
            padding: 18px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 18px;
            font-weight: 700;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px rgba(233, 30, 99, 0.3);
        }

        .product-detail-add-btn:hover {
            background: linear-gradient(135deg, var(--accent-dark) 0%, var(--accent) 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(233, 30, 99, 0.4);
        }

        .product-reviews {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 2px solid var(--border-color);
        }

        .product-reviews h4 {
            color: var(--text-primary);
            font-size: 22px;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .review-item {
            background: var(--bg-secondary);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 15px;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .review-author {
            font-weight: 700;
            color: var(--text-primary);
        }

        .review-date {
            color: var(--text-secondary);
            font-size: 14px;
        }

        .review-stars {
            color: #ffc107;
            margin-bottom: 10px;
        }

        .review-text {
            color: var(--text-secondary);
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .hero h1 {
                font-size: 32px;
            }
            
            .products-section {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                position: static;
            }

            .products-grid {
                grid-template-columns: 1fr;
            }

            .product-detail-header {
                flex-direction: column;
            }

            .product-detail-gallery {
                max-width: 100%;
            }

            .product-detail-name {
                font-size: 24px;
            }

            .product-detail-price {
                font-size: 32px;
            }

            .product-video iframe {
                height: 250px;
            }
        }

        .footer {
            background: linear-gradient(135deg, #1e3a5f 0%, #2d4a6f 100%);
            color: white;
            padding: 60px 20px 30px;
            margin-top: 80px;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-section h3 {
            font-size: 20px;
            margin-bottom: 20px;
            color: #e91e63;
            font-weight: 700;
        }

        .footer-section p, .footer-section a {
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.8;
            text-decoration: none;
            display: block;
            margin-bottom: 10px;
            transition: color 0.3s;
        }

        .footer-section a:hover {
            color: #e91e63;
        }

        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .social-link {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: all 0.3s;
        }

        .social-link:hover {
            background: #e91e63;
            transform: translateY(-3px);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 30px;
            text-align: center;
            color: rgba(255, 255, 255, 0.6);
        }

        /* Admin Panel Styles */
        .admin-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
            color: white;
            border: none;
            padding: 15px 25px;
            border-radius: 50px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 700;
            box-shadow: 0 4px 20px rgba(255, 152, 0, 0.4);
            transition: all 0.3s;
            z-index: 999;
        }

        .admin-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 30px rgba(255, 152, 0, 0.6);
        }

        .admin-panel {
            background: var(--bg-card);
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 30px;
        }

        .admin-panel h2 {
            color: var(--text-primary);
            margin-bottom: 25px;
            font-size: 28px;
            border-bottom: 3px solid #ff9800;
            padding-bottom: 15px;
        }

        .admin-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            border-bottom: 2px solid var(--border-color);
        }

        .admin-tab {
            padding: 12px 24px;
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            color: var(--text-secondary);
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }

        .admin-tab:hover {
            color: var(--text-primary);
        }

        .admin-tab.active {
            color: #ff9800;
            border-bottom-color: #ff9800;
        }

        .admin-content {
            display: none;
        }

        .admin-content.active {
            display: block;
        }

        .product-form {
            background: var(--bg-secondary);
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .product-form h3 {
            color: var(--text-primary);
            margin-bottom: 20px;
            font-size: 20px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin-bottom: 15px;
        }

        .form-grid .form-group {
            margin-bottom: 0;
        }

        .product-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-card);
            border-radius: 12px;
            overflow: hidden;
        }

        .product-table th {
            background: var(--primary-dark);
            color: white;
            padding: 15px;
            text-align: left;
            font-weight: 600;
        }

        .product-table td {
            padding: 15px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .product-table tr:hover {
            background: var(--bg-secondary);
        }

        .action-btn {
            padding: 8px 15px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            margin-right: 8px;
            transition: all 0.3s;
        }

        .edit-btn {
            background: #2196f3;
            color: white;
        }

        .edit-btn:hover {
            background: #1976d2;
            transform: translateY(-2px);
        }

        .delete-btn {
            background: #f44336;
            color: white;
        }

        .delete-btn:hover {
            background: #d32f2f;
            transform: translateY(-2px);
        }

        .save-btn {
            background: #4caf50;
            color: white;
        }

        .save-btn:hover {
            background: #388e3c;
        }

        .cancel-btn {
            background: #9e9e9e;
            color: white;
        }

        .cancel-btn:hover {
            background: #757575;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-card) 100%);
            padding: 25px;
            border-radius: 15px;
            border: 2px solid var(--border-color);
        }

        .stat-card h4 {
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .stat-card .value {
            font-size: 32px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .order-list {
            background: var(--bg-card);
            border-radius: 12px;
            overflow: hidden;
        }

        .order-item {
            padding: 20px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .order-item:hover {
            background: var(--bg-secondary);
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending {
            background: #ff9800;
            color: white;
        }

        .status-completed {
            background: #4caf50;
            color: white;
        }

        .status-cancelled {
            background: #f44336;
            color: white;
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <span class="emoji">🎮</span>
                    <span>Play4Solidarity – By Game4Change</span>
                </div>
                <div class="header-actions">
                    <button class="theme-toggle" onclick="toggleTheme()" aria-label="Changer de thème">
                        <span id="themeIcon">🌙</span>
                    </button>
                    <button class="cart-btn" onclick="toggleCart()" aria-label="Ouvrir le panier">
                        🛒 Panier
                        <span class="cart-count" id="cartCount" aria-label="Nombre d'articles">0</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <section class="hero">
        <h1>Boutique Gaming Solidaire</h1>
        <p>Équipez-vous pour vos sessions gaming tout en soutenant une cause</p>
        <div class="impact-counter">
            <h3>💝 Impact Solidaire</h3>
            <div class="impact-number"><span id="donationCounter">12,450</span> DT</div>
            <div class="impact-text">Total des dons générés grâce à votre soutien</div>
        </div>
        <div class="search-container" style="margin-top: 40px;">
            <input 
                type="text" 
                class="search-input" 
                id="searchInput" 
                placeholder="🔍 Rechercher un produit..."
                oninput="searchProducts()"
                aria-label="Rechercher un produit"
            >
            <span class="search-icon" aria-hidden="true">🔍</span>
        </div>
    </section>

    <section class="products-section" role="main">
        <div class="sidebar">
            <h3>Catégories</h3>
            <div class="category-item active" onclick="filterCategory('all')">
                <span class="category-icon">🎮</span>
                <span>Tous les produits</span>
            </div>
            <div class="category-item" onclick="filterCategory('keyboard')">
                <span class="category-icon">⌨️</span>
                <span>Claviers</span>
            </div>
            <div class="category-item" onclick="filterCategory('mouse')">
                <span class="category-icon">🖱️</span>
                <span>Souris</span>
            </div>
            <div class="category-item" onclick="filterCategory('headset')">
                <span class="category-icon">🎧</span>
                <span>Casques</span>
            </div>
            <div class="category-item" onclick="filterCategory('monitor')">
                <span class="category-icon">🖥️</span>
                <span>Écrans</span>
            </div>
            <div class="category-item" onclick="filterCategory('chair')">
                <span class="category-icon">🪑</span>
                <span>Chaises</span>
            </div>
            <div class="category-item" onclick="filterCategory('accessories')">
                <span class="category-icon">📦</span>
                <span>Accessoires</span>
            </div>
            <div class="category-item" onclick="filterCategory('streaming')">
                <span class="category-icon">📹</span>
                <span>Streaming</span>
            </div>
            <div class="category-item" onclick="filterCategory('controller')">
                <span class="category-icon">🎮</span>
                <span>Manettes</span>
            </div>
        </div>
        <div class="products-container">
            <div class="products-grid" id="productsGrid"></div>
        </div>
    </section>

    <!-- Modal Panier et Checkout -->
    <div class="modal" id="cartModal">
        <div class="modal-content">
            <button class="close-btn" onclick="toggleCart()">×</button>
            
            <div class="success-message" id="successMessage">
                ✓ Commande confirmée ! Merci de votre soutien.
            </div>

            <!-- Vue Panier -->
            <div id="cart-view">
                <h2 style="margin-bottom: 20px; color: var(--text-primary);">Mon Panier</h2>
                <div class="error-message" id="errorMessage"></div>
                <div id="cartItems"></div>
                
                <div class="promo-section">
                    <label style="font-weight: 600; color: var(--text-primary);">Code promo</label>
                    <div class="promo-input">
                        <input 
                            type="text" 
                            id="promoCode" 
                            placeholder="Entrez votre code"
                            aria-label="Code promo"
                        >
                        <button class="promo-btn" onclick="applyPromo()" aria-label="Appliquer le code promo">Appliquer</button>
                    </div>
                    <div class="promo-applied" id="promoApplied"></div>
                </div>
                
                <div class="cart-total">
                    <div id="discountDisplay" style="font-size: 16px; color: #4caf50; margin-bottom: 10px;"></div>
                    Total: <span id="cartTotal">0.00 DT</span>
                </div>
                <button class="checkout-btn" onclick="goToCheckout()" aria-label="Valider le panier">Valider le panier</button>
            </div>

            <!-- Vue Formulaire (Caché par défaut) -->
            <div id="checkout-view" class="checkout-form">
                <button class="back-btn" onclick="backToCart()">← Retour au panier</button>
                <h3>Informations de livraison</h3>
                
                <form id="orderForm" onsubmit="confirmOrder(event)">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="firstname">Prénom</label>
                            <input type="text" id="firstname" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="lastname">Nom</label>
                            <input type="text" id="lastname" class="form-input" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="phone">Téléphone</label>
                        <input type="tel" id="phone" class="form-input" required>
                    </div>

                    <div class="form-group">
                        <label for="address">Adresse complète</label>
                        <input type="text" id="address" class="form-input" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="city">Ville</label>
                            <input type="text" id="city" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="zip">Code Postal</label>
                            <input type="text" id="zip" class="form-input" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="payment">Moyen de paiement</label>
                        <select id="payment" class="form-input">
                            <option value="card">Carte Bancaire</option>
                            <option value="delivery">Paiement à la livraison</option>
                            <option value="edinar">E-Dinar</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px; border-top: 1px solid var(--border-color); padding-top: 15px;">
                         <p style="text-align: right; font-weight: bold; font-size: 18px; color: var(--text-primary); margin-bottom: 15px;">
                            Montant à payer: <span id="checkoutTotal">0.00 DT</span>
                         </p>
                    </div>

                    <button type="submit" class="checkout-btn" aria-label="Confirmer la commande">Confirmer la commande</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Confirmation -->
    <div class="modal" id="confirmationModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeConfirmation()" aria-label="Fermer">×</button>
            <div style="text-align: center; padding: 20px;">
                <div style="font-size: 64px; margin-bottom: 20px;">✅</div>
                <h2 style="color: var(--text-primary); margin-bottom: 15px;">Commande Confirmée!</h2>
                <p style="color: var(--text-secondary); margin-bottom: 20px;" id="confirmationText">
                    Merci pour votre commande! Vous recevrez un email de confirmation sous peu.
                </p>
                <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 20px;">
                    Numéro de commande: <strong id="orderNumber"></strong>
                </p>
                <button class="checkout-btn" onclick="viewOrderHistory()" aria-label="Voir l'historique">Voir mes commandes</button>
            </div>
        </div>
    </div>

    <!-- Modal Historique -->
    <div class="modal" id="historyModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeHistory()" aria-label="Fermer">×</button>
            <h2 style="margin-bottom: 20px; color: var(--text-primary);">Historique des Commandes</h2>
            <div id="orderHistory"></div>
        </div>
    </div>

    <div class="product-detail-modal" id="productDetailModal">
        <div class="product-detail-content">
            <button class="close-btn" onclick="closeProductDetail()">×</button>
            
            <div class="product-detail-header">
                <!-- Gallery Section -->
                <div class="product-detail-gallery">
                    <div class="product-detail-main-image" id="mainImageContainer">
                        <img id="mainProductImage" alt="Product">
                    </div>
                    <div class="product-detail-thumbnails" id="thumbnailsContainer"></div>
                </div>

                <!-- Info Section -->
                <div class="product-detail-info">
                    <div class="product-detail-category" id="detailCategory"></div>
                    <h2 class="product-detail-name" id="detailName"></h2>
                    
                    <div class="product-detail-rating">
                        <span class="stars" id="detailStars"></span>
                        <span style="color: var(--text-secondary);" id="detailReviews"></span>
                    </div>
                    
                    <div class="product-detail-price" id="detailPrice"></div>
                    
                    <div class="product-detail-stock" id="detailStock"></div>
                    
                    <p class="product-detail-description" id="detailDescription"></p>
                    
                    <div class="product-detail-actions">
                        <div class="quantity-selector">
                            <button onclick="decreaseDetailQuantity()" aria-label="Diminuer">-</button>
                            <span id="detailQuantity">1</span>
                            <button onclick="increaseDetailQuantity()" aria-label="Augmenter">+</button>
                        </div>
                        <button class="product-detail-add-btn" id="detailAddBtn">
                            🛒 Ajouter au panier
                        </button>
                    </div>
                </div>
            </div>

            <!-- Product Specs -->
            <div class="product-specs" id="productSpecs"></div>

            <!-- Product Features -->
            <div class="product-features" id="productFeatures"></div>

            <!-- Product Video -->
            <div class="product-video" id="productVideo"></div>

            <!-- Product Reviews -->
            <div class="product-reviews" id="productReviews"></div>
        </div>
    </div>

    <footer class="footer">
