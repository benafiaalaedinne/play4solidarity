                total: total.toFixed(2),
                customer: firstname,
                status: 'En cours'
            };
            
            orderHistory.unshift(order);
            saveOrders();
            
            document.getElementById('checkout-view').style.display = 'none';
            toggleCart();
            
            setTimeout(() => {
                showConfirmation(orderNumber, firstname);
            }, 300);
            
            cart = [];
            promoDiscount = 0;
            appliedPromo = null;
            saveCart();
            updateCart();
            document.getElementById('orderForm').reset();
            document.getElementById('promoCode').value = '';
            document.getElementById('promoApplied').textContent = '';
        }

        function showConfirmation(orderNumber, firstname) {
            document.getElementById('orderNumber').textContent = orderNumber;
            document.getElementById('confirmationText').textContent = 
                `Merci ${firstname}! Votre commande a été enregistrée avec succès.`;
            document.getElementById('confirmationModal').classList.add('active');
        }

        function closeConfirmation() {
            document.getElementById('confirmationModal').classList.remove('active');
        }

        function viewOrderHistory() {
            closeConfirmation();
            const historyDiv = document.getElementById('orderHistory');
            
            if (orderHistory.length === 0) {
                historyDiv.innerHTML = '<div class="empty-cart">Aucune commande pour le moment</div>';
            } else {
                historyDiv.innerHTML = orderHistory.map(order => `
                    <div style="padding: 15px; border: 1px solid var(--border-color); border-radius: 12px; margin-bottom: 15px; background: var(--bg-secondary);">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <strong style="color: var(--text-primary);">${order.orderNumber}</strong>
                            <span style="color: var(--text-secondary);">${order.date}</span>
                        </div>
                        <div style="color: var(--text-secondary); margin-bottom: 8px;">
                            ${order.items.length} article(s) - ${order.total} DT
                        </div>
                        <div style="color: #4caf50; font-weight: 600;">Status: ${order.status}</div>
                    </div>
                `).join('');
            }
            
            document.getElementById('historyModal').classList.add('active');
        }

        function closeHistory() {
            document.getElementById('historyModal').classList.remove('active');
        }

        function animateDonationCounter(target) {
            const counter = document.getElementById('donationCounter');
            const start = parseFloat(counter.textContent.replace(/,/g, ''));
            const duration = 1000;
            const increment = (target - start) / (duration / 16);
            
            let current = start;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                counter.textContent = Math.floor(current).toLocaleString();
            }, 16);
        }

        function showProductDetail(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            currentDetailProduct = product;
            currentDetailQuantity = 1;

            const categoryNames = {
                'keyboard': 'Claviers',
                'mouse': 'Souris',
                'headset': 'Casques',
                'monitor': 'Écrans',
                'chair': 'Chaises',
                'accessories': 'Accessoires',
                'streaming': 'Streaming',
                'controller': 'Manettes'
            };

            // Update basic info
            document.getElementById('detailName').textContent = product.name;
            document.getElementById('detailPrice').textContent = product.price + ' DT';
            document.getElementById('detailDescription').textContent = product.description;
            document.getElementById('detailCategory').textContent = categoryNames[product.category] || product.category;
            document.getElementById('detailStars').textContent = getStars(product.rating);
            document.getElementById('detailReviews').textContent = `(${product.reviews} avis)`;
            document.getElementById('detailQuantity').textContent = currentDetailQuantity;

            // Update stock badge
            const stockEl = document.getElementById('detailStock');
            if (product.stock === 0) {
                stockEl.textContent = '❌ Rupture de stock';
                stockEl.className = 'product-detail-stock out-of-stock';
            } else if (product.stock <= 5) {
                stockEl.textContent = `⚠️ Stock limité (${product.stock} restants)`;
                stockEl.className = 'product-detail-stock low-stock';
            } else {
                stockEl.textContent = `✅ En stock (${product.stock} disponibles)`;
                stockEl.className = 'product-detail-stock in-stock';
            }

            // Update gallery
            const mainImage = document.getElementById('mainProductImage');
            const thumbnails = document.getElementById('thumbnailsContainer');
            
            if (product.images && product.images.length > 0) {
                mainImage.src = product.images[0];
                mainImage.alt = product.name;
                
                thumbnails.innerHTML = product.images.map((img, index) => `
                    <div class="thumbnail ${index === 0 ? 'active' : ''}" onclick="changeMainImage('${img}', ${index})">
                        <img src="${img}" alt="${product.name} ${index + 1}">
                    </div>
                `).join('');
            } else {
                mainImage.src = product.image;
                mainImage.alt = product.name;
                thumbnails.innerHTML = '';
            }

            // Update specs
            const specsEl = document.getElementById('productSpecs');
            if (product.specs) {
                specsEl.innerHTML = `
                    <h4>📋 Spécifications techniques</h4>
                    ${Object.entries(product.specs).map(([key, value]) => `
                        <div class="spec-item">
                            <span class="spec-label">${key}</span>
                            <span class="spec-value">${value}</span>
                        </div>
                    `).join('')}
                `;
                specsEl.style.display = 'block';
            } else {
                specsEl.style.display = 'none';
            }

            // Update features
            const featuresEl = document.getElementById('productFeatures');
            if (product.features && product.features.length > 0) {
                featuresEl.innerHTML = `
                    <h4>✨ Caractéristiques principales</h4>
                    ${product.features.map(feature => `
                        <div class="feature-item">${feature}</div>
                    `).join('')}
                `;
                featuresEl.style.display = 'block';
            } else {
                featuresEl.style.display = 'none';
            }

            // Update video
            const videoEl = document.getElementById('productVideo');
            if (product.video) {
                videoEl.innerHTML = `
                    <h4 style="color: var(--text-primary); margin-bottom: 15px; font-weight: 700;">🎥 Vidéo de présentation</h4>
                    <iframe src="${product.video}" allowfullscreen></iframe>
                `;
                videoEl.style.display = 'block';
            } else {
                videoEl.style.display = 'none';
            }

            // Update reviews
            const reviewsEl = document.getElementById('productReviews');
            if (product.reviewsList && product.reviewsList.length > 0) {
                reviewsEl.innerHTML = `
                    <h4>⭐ Avis clients (${product.reviews})</h4>
                    ${product.reviewsList.map(review => `
                        <div class="review-item">
                            <div class="review-header">
                                <span class="review-author">${review.author}</span>
                                <span class="review-date">${review.date}</span>
                            </div>
                            <div class="review-stars">${'⭐'.repeat(review.rating)}</div>
                            <div class="review-text">${review.text}</div>
                        </div>
                    `).join('')}
                `;
                reviewsEl.style.display = 'block';
            } else {
                reviewsEl.style.display = 'none';
            }

            // Setup add to cart button
            const addBtn = document.getElementById('detailAddBtn');
            if (product.stock === 0) {
                addBtn.disabled = true;
                addBtn.style.opacity = '0.5';
                addBtn.style.cursor = 'not-allowed';
                addBtn.textContent = '❌ Rupture de stock';
            } else {
                addBtn.disabled = false;
                addBtn.style.opacity = '1';
                addBtn.style.cursor = 'pointer';
                addBtn.textContent = '🛒 Ajouter au panier';
                addBtn.onclick = () => {
                    for (let i = 0; i < currentDetailQuantity; i++) {
                        addToCart(productId);
                    }
                    closeProductDetail();
                };
            }

            document.getElementById('productDetailModal').classList.add('active');
        }

        function changeMainImage(imageSrc, index) {
            document.getElementById('mainProductImage').src = imageSrc;
            document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
                thumb.classList.toggle('active', i === index);
            });
        }

        function increaseDetailQuantity() {
            if (currentDetailProduct && currentDetailQuantity < currentDetailProduct.stock) {
                currentDetailQuantity++;
                document.getElementById('detailQuantity').textContent = currentDetailQuantity;
            }
        }

        function decreaseDetailQuantity() {
            if (currentDetailQuantity > 1) {
                currentDetailQuantity--;
                document.getElementById('detailQuantity').textContent = currentDetailQuantity;
            }
        }

        function closeProductDetail() {
            document.getElementById('productDetailModal').classList.remove('active');
            currentDetailQuantity = 1;
            currentDetailProduct = null;
        }

        // === ADMIN FUNCTIONS ===
        
        function toggleAdminPanel() {
            const modal = document.getElementById('adminModal');
            modal.classList.toggle('active');
            if (modal.classList.contains('active')) {
                refreshAdminData();
            }
        }

        function switchAdminTab(tabName) {
            // Update tabs
            document.querySelectorAll('.admin-tab').forEach(tab => tab.classList.remove('active'));
            event.target.classList.add('active');
            
            // Update content
            document.querySelectorAll('.admin-content').forEach(content => content.classList.remove('active'));
            document.getElementById(tabName + '-tab').classList.add('active');
            
            refreshAdminData();
        }

        function refreshAdminData() {
            renderProductsTable();
            renderAdminOrders();
            renderStats();
        }

        function renderProductsTable() {
            const tbody = document.getElementById('productsTableBody');
            if (!tbody) return;
            
            tbody.innerHTML = products.map(product => `
                <tr>
                    <td>${product.id}</td>
                    <td>${product.name}</td>
                    <td>${product.price} DT</td>
                    <td>${product.category}</td>
                    <td>${product.stock}</td>
                    <td>
                        <button class="action-btn edit-btn" onclick="editProduct(${product.id})" aria-label="Modifier">
                            ✏️ Modifier
                        </button>
                        <button class="action-btn delete-btn" onclick="deleteProduct(${product.id})" aria-label="Supprimer">
                            🗑️ Supprimer
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function saveProduct(event) {
            event.preventDefault();
            
            const productData = {
                name: document.getElementById('productName').value,
                description: document.getElementById('productDescription').value,
                price: parseFloat(document.getElementById('productPrice').value),
                category: document.getElementById('productCategory').value,
                stock: parseInt(document.getElementById('productStock').value),
                rating: parseFloat(document.getElementById('productRating').value),
                reviews: parseInt(document.getElementById('productReviews').value),
                image: document.getElementById('productImage').value,
                icon: document.getElementById('productIcon').value
            };
            
            const editId = document.getElementById('editProductId').value;
            
            if (editId) {
                // Update existing product
                const index = products.findIndex(p => p.id === parseInt(editId));
                if (index !== -1) {
                    products[index] = { ...products[index], ...productData };
                    showError('✅ Produit mis à jour avec succès');
                }
            } else {
                // Add new product
                const newId = Math.max(...products.map(p => p.id)) + 1;
                products.push({ id: newId, ...productData });
                showError('✅ Produit ajouté avec succès');
            }
            
            // Save to localStorage
            try {
                localStorage.setItem('play4solidarity_products', JSON.stringify(products));
            } catch (error) {
                showError('Erreur lors de la sauvegarde des produits');
            }
            
            // Reset form and refresh
            cancelEdit();
            renderProducts();
            renderProductsTable();
        }

        function editProduct(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;
            
            editingProductId = productId;
            document.getElementById('editProductId').value = productId;
            document.getElementById('productName').value = product.name;
            document.getElementById('productDescription').value = product.description;
            document.getElementById('productPrice').value = product.price;
            document.getElementById('productCategory').value = product.category;
            document.getElementById('productStock').value = product.stock;
            document.getElementById('productRating').value = product.rating;
            document.getElementById('productReviews').value = product.reviews;
            document.getElementById('productImage').value = product.image;
            document.getElementById('productIcon').value = product.icon;
            
            document.getElementById('formTitle').textContent = '✏️ Modifier le produit';
            document.getElementById('productForm').scrollIntoView({ behavior: 'smooth' });
        }

        function deleteProduct(productId) {
            if (!confirm('Êtes-vous sûr de vouloir supprimer ce produit ?')) return;
            
            const index = products.findIndex(p => p.id === productId);
            if (index !== -1) {
                products.splice(index, 1);
                
                // Save to localStorage
                try {
                    localStorage.setItem('play4solidarity_products', JSON.stringify(products));
                    showError('✅ Produit supprimé avec succès');
                } catch (error) {
                    showError('Erreur lors de la suppression du produit');
                }
                
                renderProducts();
                renderProductsTable();
            }
        }

        function cancelEdit() {
            editingProductId = null;
            document.getElementById('editProductId').value = '';
            document.getElementById('productForm').reset();
            document.getElementById('formTitle').textContent = '➕ Ajouter un nouveau produit';
        }

        function renderAdminOrders() {
            const ordersList = document.getElementById('adminOrdersList');
            if (!ordersList) return;
            
            if (orderHistory.length === 0) {
                ordersList.innerHTML = '<div class="empty-cart">Aucune commande</div>';
                return;
            }
            
            ordersList.innerHTML = orderHistory.map((order, index) => `
                <div class="order-item">
                    <div>
                        <strong style="color: var(--text-primary);">${order.orderNumber}</strong>
                        <div style="color: var(--text-secondary); font-size: 14px; margin-top: 5px;">
                            ${order.customer} - ${order.date} - ${order.items.length} article(s)
                        </div>
                        <div style="margin-top: 5px;">
                            <strong style="color: var(--accent);">${order.total} DT</strong>
                        </div>
                    </div>
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <select class="form-input" style="width: auto;" onchange="updateOrderStatus(${index}, this.value)">
                            <option value="En cours" ${order.status === 'En cours' ? 'selected' : ''}>En cours</option>
                            <option value="Expédiée" ${order.status === 'Expédiée' ? 'selected' : ''}>Expédiée</option>
                            <option value="Livrée" ${order.status === 'Livrée' ? 'selected' : ''}>Livrée</option>
                            <option value="Annulée" ${order.status === 'Annulée' ? 'selected' : ''}>Annulée</option>
                        </select>
                        <button class="action-btn delete-btn" onclick="deleteOrder(${index})">
                            🗑️
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function updateOrderStatus(index, newStatus) {
            orderHistory[index].status = newStatus;
            saveOrders();
            renderAdminOrders();
            showError('✅ Statut de la commande mis à jour');
        }

        function deleteOrder(index) {
            if (!confirm('Êtes-vous sûr de vouloir supprimer cette commande ?')) return;
            
            orderHistory.splice(index, 1);
            saveOrders();
            renderAdminOrders();
            renderStats();
            showError('✅ Commande supprimée');
        }

        function renderStats() {
            const totalProducts = document.getElementById('statTotalProducts');
            const totalOrders = document.getElementById('statTotalOrders');
            const totalRevenue = document.getElementById('statTotalRevenue');
            const totalDonationsEl = document.getElementById('statTotalDonations');
            const outOfStockList = document.getElementById('outOfStockList');
            
            if (totalProducts) totalProducts.textContent = products.length;
            if (totalOrders) totalOrders.textContent = orderHistory.length;
            
            if (totalRevenue) {
                const revenue = orderHistory.reduce((sum, order) => sum + parseFloat(order.total), 0);
                totalRevenue.textContent = revenue.toFixed(2) + ' DT';
            }
            
            if (totalDonationsEl) {
                totalDonationsEl.textContent = totalDonations.toLocaleString() + ' DT';
            }
            
            if (outOfStockList) {
                const outOfStock = products.filter(p => p.stock === 0);
                if (outOfStock.length === 0) {
                    outOfStockList.innerHTML = '<div class="empty-cart">Aucun produit en rupture</div>';
                } else {
                    outOfStockList.innerHTML = outOfStock.map(product => `
                        <div class="order-item">
                            <div>
                                <strong style="color: var(--text-primary);">${product.name}</strong>
                                <div style="color: var(--text-secondary); font-size: 14px; margin-top: 5px;">
                                    Catégorie: ${product.category} - Prix: ${product.price} DT
                                </div>
                            </div>
                            <button class="action-btn edit-btn" onclick="editProduct(${product.id})">
                                ✏️ Modifier
                            </button>
                        </div>
                    `).join('');
                }
            }
        }

        // Load products from localStorage on startup
        function loadProducts() {
            try {
                const savedProducts = localStorage.getItem('play4solidarity_products');
                if (savedProducts) {
                    const parsed = JSON.parse(savedProducts);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        products.length = 0;
                        products.push(...parsed);
                    }
                }
            } catch (error) {
                console.error('Error loading products:', error);
            }
        }

        // Charger les données au démarrage
        loadProducts();
        loadFromStorage();
        renderProducts();
    </script>
</body>
</html>
